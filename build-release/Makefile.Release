	$(QINSTALL) "C:\Users\mitch\Documents\AntiGravity Projects\SavvyCAN\examples" $(INSTALL_ROOT:@msyshack@%=%)\share\savvycan\examples\examples

uninstall_examplefiles: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT:@msyshack@%=%)\share\savvycan\examples\examples
